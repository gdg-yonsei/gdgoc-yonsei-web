{
  "name": "gdgoc-yonsei-web",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm auth:prepare && next build",
    "build:production": "drizzle-kit migrate && pnpm build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:prod": "E2E_SEEDED_BEFORE_BUILD=1 NEXT_EXPOSE_TESTING_API=1 playwright test --config=playwright.production.config.ts",
    "test:types": "next typegen && tsc --noEmit",
    "test:e2e:install": "playwright install chromium",
    "perf:measure": "node scripts/measure-next-performance.mjs",
    "perf:instant": "node scripts/verify-instant-navigation.mjs",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "format": "prettier -w .",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-dev.ts",
    "auth:prepare": "tsx --conditions=react-server scripts/prepare-auth.ts",
    "email:dev": "email dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/lib-storage": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@better-auth/cimd": "1.7.6",
    "@better-auth/mcp": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@formatjs/intl-localematcher": "^0.9.0",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@next/third-parties": "16.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "animejs": "4.5.0",
    "better-auth": "1.7.6",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "jotai": "^3.0.1",
    "motion": "^13.5.1",
    "negotiator": "^1.1.0",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "6.11.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "redis": "^6.3.0",
    "rehype-sanitize": "^6.0.0",
    "resend": "^6.32.0",
    "satori": "0.33.5",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/playwright": "16.3.6",
    "@playwright/test": "^1.63.0",
    "@react-email/ui": "6.11.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "baseline-browser-mapping": "^2.11.27",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "postcss": "8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13.0 <=24"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
